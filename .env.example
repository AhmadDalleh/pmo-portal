# Copy to .env (never committed) and change the password.
POSTGRES_DB=pmo
POSTGRES_USER=pmo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by the API when it runs in Docker (later sessions). Locally, use dotnet user-secrets instead.
ConnectionStrings__Default=Host=db;Port=5432;Database=pmo;Username=pmo;Password=change-me
