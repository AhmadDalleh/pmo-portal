# Copy to .env (never committed) and change the password.
POSTGRES_DB=pmo
POSTGRES_USER=pmo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Used by the API when it runs in Docker (later sessions). Locally, use dotnet user-secrets instead.
ConnectionStrings__Default=Host=db;Port=5432;Database=pmo;Username=pmo;Password=change-me

# Host port of the database container (compose maps it to 5432 inside the container).
DB_HOST_PORT=5433

# Password given to every demo user by the importer (scripts/import-data.*). Never committed, never in the CSV files.
DEMO_USER_PASSWORD=change-me-too

# JWT signing key for Docker runs (locally use dotnet user-secrets "Jwt:Key"). 32+ random characters.
Jwt__Key=change-me-to-a-long-random-string-32-chars-min
